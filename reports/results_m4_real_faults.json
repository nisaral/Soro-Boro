  "benchmark_nature": "Controlled Mechanism Evaluation: Demonstrates recovery mechanism under an injected 40/30/15/15 fault mix. Transient probe crashes recover on retry by construction, and id-based lookup avoids the race by construction. Operational field deferral rates depend on real network distributions and are measured via Soro Shadow Mode.",
  "breakthrough_finding": "By embedding action_id into write payloads and querying by correlation id (rather than generic state), Soro cuts confirmation deferral from 30.0% down to 5.4% while maintaining 0.0% duplicate mutations. The 30.0% deferral rate remains strictly necessary only in opaque tools where no correlation ID can be embedded.",
  "fault_mix_protocol": {
    "regime_1_pre_commit": "300 trials (30%) - write never committed on server",
    "regime_2_post_commit": "400 trials (40%) - write committed, response severed (AT-RISK)",
    "regime_3_verifier_crash": "150 trials (15%) - probe error or timeout (AT-RISK)",
    "regime_4_concurrent_race": "150 trials (15%) - adversarial concurrent update during uncertain window (AT-RISK STRESS TEST)",
    "total_at_risk_trials_per_system": 700,
    "total_systems_evaluated": 4,
    "total_at_risk_trials_across_all_systems": 2800,
