{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nisaral/Veyra/schemas/handoff.v1.json",
  "title": "HandoffV1",
  "description": "State that may cross a harness switch. Compatible in spirit with Harbor ATIF. Kev scores items; it does not generate this document.",
  "type": "object",
  "required": ["version", "task_id", "from_harness", "items"],
  "properties": {
    "version": { "const": "1" },
    "task_id": { "type": "string" },
    "from_harness": { "type": "string" },
    "to_harness": { "type": ["string", "null"] },
    "shadow": { "type": "boolean", "description": "true = would have switched, did not act" },
    "budget": {
      "type": "object",
      "properties": {
        "usd_spent": { "type": "number" },
        "usd_remaining": { "type": ["number", "null"] },
        "actions": { "type": "integer" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text"],
        "properties": {
          "kind": {
            "enum": ["decision", "failed_action", "open_subgoal", "verification", "observation"]
          },
          "text": { "type": "string" },
          "keep_score": { "type": ["number", "null"] }
        }
      }
    }
  }
}
